    {
      "id": "labelLayout",
      "urlKey": "ll",
      "label": "Category label layout",
      "section": "Labels & bar size",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto-fit"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "angled",
          "label": "Angled (45\u00b0)"
        },
        {
          "value": "wrap",
          "label": "Wrap to lines"
        }
      ],
      "help": "How long category labels are fitted. Auto wraps them into the label column on horizontal bars, and angles or wraps them on vertical bars when they'd collide \u2014 instead of truncating them.",
      "showIf": {
        "chartType": [
          "bar",
          "bar-horizontal",
          "lollipop",
          "dumbbell"
        ]
      }
    },
    {
      "id": "labelReserve",
      "urlKey": "lr",
      "label": "Label area (%, 0 = auto)",
      "section": "Labels & bar size",
      "type": "number",
      "display": "slider",
      "default": 0,
      "min": 0,
      "max": 60,
      "step": 1,
      "help": "How much of the picture to hand to the category labels \u2014 the width of the label column on horizontal bars, or the height of the label strip on vertical bars. 0 fits automatically; raise it to give long labels more room (the bars take the rest).",
      "showIf": {
        "chartType": [
          "bar",
          "bar-horizontal",
          "lollipop",
          "dumbbell"
        ]
      }
    },
    {
      "id": "labelLines",
      "urlKey": "ln",
      "label": "Max label lines",
      "section": "Labels & bar size",
      "type": "number",
      "display": "slider",
      "default": 2,
      "min": 1,
      "max": 4,
      "step": 1,
      "help": "How many lines a wrapped category label may use before it's trimmed with an ellipsis.",
      "showIf": {
        "chartType": [
          "bar",
          "bar-horizontal",
          "lollipop",
          "dumbbell"
        ]
      }
    },
    {
      "id": "barThickness",
      "urlKey": "bt",
      "label": "Bar thickness (px, 0 = auto)",
      "section": "Labels & bar size",
      "type": "number",
      "display": "slider",
      "default": 0,
      "min": 0,
      "max": 400,
      "step": 1,
      "help": "Cap the thickness of each bar. 0 lets bars fill their slot; a value makes them thinner and centres them, freeing space for labels.",
      "showIf": {
        "chartType": [
          "bar",
          "bar-horizontal"
        ]
      }
    },
    {
      "id": "yScaleType",
      "urlKey": "ys",
      "label": "Value scale",
