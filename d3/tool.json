    {
      "id": "data",
      "urlKey": "d",
      "label": "Paste your table",
      "type": "longtext",
      "dataSource": {},
      "rows": 9,
      "placeholder": "Quarter,SLES,Rancher,Edge\nQ1,42,28,12\nQ2,49,35,18",
      "help": "Copy cells straight from Excel, Google Sheets or Numbers and paste here \u2014 they come across as a clean table (no fiddling with commas). Or type/paste CSV or TSV. First row = column headers; the first text column becomes the labels and every numeric column a series. The chart rebuilds automatically.",
      "default": "Quarter,SLES,Rancher,Edge\nQ1,42,28,12\nQ2,49,35,18\nQ3,55,41,24\nQ4,63,52,33"
    },
    {
      "id": "hasHeader",
      "urlKey": "hh",
      "label": "First row is a header",
      "section": "Data",
      "type": "boolean",
      "default": true
    },
    {
      "id": "delimiter",
      "urlKey": "dl",
      "label": "Column separator",
      "section": "Data",
      "type": "select",
      "default": "auto",
      "options": [
        {
          "value": "auto",
          "label": "Auto-detect"
        },
        {
          "value": "comma",
          "label": "Comma  ,"
        },
        {
          "value": "tab",
          "label": "Tab"
        },
        {
          "value": "semicolon",
          "label": "Semicolon  ;"
        },
        {
          "value": "pipe",
          "label": "Pipe  |"
        }
      ]
    },
    {
      "id": "transpose",
      "urlKey": "tp",
      "label": "Swap rows & columns",
      "section": "Data",
      "type": "boolean",
      "default": false,
      "help": "Flip the table so the header row becomes the categories and each row becomes a series."
    },
    {
      "id": "labelColumn",
      "urlKey": "lc",
      "label": "Label column",
      "section": "Columns",
      "type": "text",
      "default": "",
      "placeholder": "auto (first column)",
      "help": "Which column holds the category / x-axis labels \u2014 a column name or its number (1 = first). Blank = the first column."
    },
    {
      "id": "seriesColumns",
      "urlKey": "sc",
      "label": "Series columns",
      "section": "Columns",
      "type": "text",
      "default": "",
      "placeholder": "auto (all numeric)",
      "help": "Which columns to plot, comma-separated (names or numbers), in the order you list them. Blank = every numeric column."
    },
    {
      "id": "pivotColumn",
      "urlKey": "pv",
      "label": "Pivot by column",
      "section": "Columns",
      "type": "text",
      "default": "",
      "placeholder": "auto (for long data)",
      "help": "For long / tidy data (one row per observation): the column whose values become the separate series. Blank = auto-detect."
    },
    {
      "id": "frameColumn",
      "urlKey": "fc",
      "label": "Animate by column",
      "section": "Columns",
      "type": "text",
      "default": "",
      "placeholder": "e.g. Quarter, Year, Wave",
      "help": "Name (or 1-based number) of a frame / time column \u2014 its distinct values (e.g. Q1, Q2, Q3) become animation keyframes. The chart morphs between them and loops. Export as looping APNG, MP4/WebM, or animated SVG. Works with bar, horizontal bar, line and area.",
      "showIf": {
        "chartType": [
          "bar",
          "bar-horizontal",
          "line",
          "area"
        ]
      }
    },
    {
      "id": "animSpeed",
      "urlKey": "as",
      "label": "Seconds per frame",
      "section": "Animation",
      "type": "number",
      "default": 1.5,
      "min": 0.3,
      "max": 8,
      "step": 0.1,
      "help": "How long each keyframe holds before morphing to the next. One full loop = frames \u00d7 this. Set the export duration to a multiple for a seamless loop.",
      "showIf": {
        "chartType": [
          "bar",
          "bar-horizontal",
          "line",
          "area"
        ]
      }
    },
    {
      "id": "frameLabelShow",
      "urlKey": "fl",
      "label": "Show frame label",
      "section": "Animation",
      "type": "boolean",
      "default": true,
      "help": "Show the current keyframe's name (e.g. the quarter) as a caption while the animation plays.",
      "showIf": {
        "chartType": [
          "bar",
          "bar-horizontal",
          "line",
          "area"
        ]
      }
    },
    {
      "id": "animEase",
      "urlKey": "ae",
      "label": "Motion",
      "section": "Animation",
      "type": "select",
      "default": "smooth",
      "options": [
        {
          "value": "smooth",
          "label": "Smooth (hold + ease)"
        },
        {
          "value": "linear",
          "label": "Linear (constant)"
        },
        {
          "value": "steps",
          "label": "Steps (snap between frames)"
        }
      ],
      "help": "How values move between keyframes: Smooth holds each frame then eases across; Linear morphs at a constant rate; Steps snaps instantly (no in-between).",
      "showIf": {
        "chartType": [
          "bar",
          "bar-horizontal",
          "line",
          "area"
        ]
      }
    },
    {
      "id": "animDirection",
      "urlKey": "ad",
      "label": "Loop style",
      "section": "Animation",
      "type": "select",
      "default": "loop",
      "options": [
        {
          "value": "loop",
          "label": "Loop (jump back to start)"
        },
        {
          "value": "bounce",
          "label": "Bounce (play back in reverse)"
        }
      ],
      "help": "Loop restarts from the first frame each cycle; Bounce plays forward then back for a seamless ping-pong.",
      "showIf": {
        "chartType": [
          "bar",
          "bar-horizontal",
          "line",
          "area"
        ]
      }
    },
    {
      "id": "stackMode",
      "urlKey": "sm",
      "label": "Series layout",
      "section": "Chart",
      "type": "select",
      "default": "grouped",
      "options": [
        {
          "value": "grouped",
          "label": "Grouped (side by side)"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        },
        {
          "value": "stacked100",
          "label": "Stacked 100%"
        }
      ],
      "showIf": {
        "chartType": [
          "bar",
          "bar-horizontal",
          "area"
        ]
      }
    },
    {
      "id": "curve",
      "urlKey": "cv",
      "label": "Line shape",
      "section": "Chart",
      "type": "select",
      "default": "monotone",
      "options": [
        {
          "value": "linear",
          "label": "Straight"
        },
        {
          "value": "monotone",
          "label": "Smooth (monotone)"
        },
        {
          "value": "natural",
          "label": "Smooth (natural)"
        },
        {
          "value": "catmullRom",
          "label": "Smooth (Catmull\u2013Rom)"
        },
        {
          "value": "cardinal",
          "label": "Smooth (cardinal)"
        },
        {
          "value": "basis",
          "label": "Smooth (basis)"
        },
        {
          "value": "step",
          "label": "Step (mid)"
        },
        {
          "value": "stepBefore",
          "label": "Step (before)"
        },
        {
          "value": "stepAfter",
          "label": "Step (after)"
        },
        {
          "value": "bumpX",
          "label": "Bump"
        }
      ],
      "showIf": {
        "chartType": [
          "line",
          "area"
        ]
      }
    },
    {
      "id": "showPoints",
      "urlKey": "pt",
      "label": "Show point markers",
      "section": "Chart",
      "type": "boolean",
      "default": false,
      "showIf": {
        "chartType": [
          "line",
          "area"
        ]
      }
    },
    {
