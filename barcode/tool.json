{
  "id": "barcode",
  "name": "Barcode Generator",
  "description": "Retail and logistics barcodes as crisp vector art - EAN-13, EAN-8, UPC-A and Code 128, with the check digit worked out for you.",
  "a11yLabel": "Barcode holding {{default bcSummary \"nothing yet\"}}",
  "version": "1.0.1",
  "engineVersion": "^1.0.0",
  "status": "community",
  "category": "everyone",
  "tags": ["barcode", "ean", "upc", "code128", "retail", "label", "inventory"],
  "render": {
    "width": 900,
    "height": 520,
    "formats": ["svg", "png", "pdf", "eps", "emf"],
    "actions": ["copy", "download", "save"],
    "filenameFrom": ["value"],
    "transparentBg": false
  },
  "hooks": {
    "onInit": true,
    "onInput": true
  },
  "inputs": [
    {
      "id": "value",
      "label": "Number or text",
      "type": "text",
      "required": true,
      "default": "4006381333931",
      "help": "The number or text printed under the bars. In a retail number spaces and hyphens are ignored; give it one digit short and the check digit is worked out for you."
    },
    {
      "id": "symbology",
      "label": "Symbology",
      "type": "select",
      "default": "auto",
      "help": "Automatic reads the shape of the value: 13 digits is EAN-13, 12 is UPC-A, 8 is EAN-8, anything else is Code 128.",
      "options": [
        { "value": "auto", "label": "Automatic" },
        { "value": "ean13", "label": "EAN-13" },
        { "value": "ean8", "label": "EAN-8" },
        { "value": "upca", "label": "UPC-A" },
        { "value": "code128", "label": "Code 128" }
      ]
    },
    {
      "id": "showText",
      "label": "Print the number",
      "type": "boolean",
      "default": true,
      "help": "The human-readable line under the bars, set in your brand's monospace face."
    },
    {
      "id": "moduleWidth",
      "label": "Bar width",
      "type": "number",
      "display": "slider",
      "default": 3,
      "min": 1,
      "max": 10,
      "step": 0.5,
      "help": "Width of one module, the thinnest bar. Retail print uses 0.33 mm; set the export size in millimetres to hit it."
    },
    {
      "id": "barHeight",
      "label": "Bar height",
      "type": "number",
      "display": "slider",
      "default": 160,
      "min": 40,
      "max": 400,
      "step": 5,
      "help": "Taller bars are easier to scan at an angle."
    },
    {
      "id": "quiet",
      "label": "Quiet zone",
      "type": "number",
      "display": "slider",
      "default": 11,
      "min": 0,
      "max": 24,
      "step": 1,
      "help": "Modules of clear space each side, and a scanner fails without it. The standards ask for 11 on an EAN-13, 10 on a Code 128, 9 on a UPC-A."
    },
    {
      "id": "color",
      "label": "Bar colour",
      "type": "color",
      "default": "{color.semantic.text}",
      "help": "Scanners read contrast, so keep the bars dark on a light background."
    },
    {
      "id": "background",
      "label": "Background",
      "type": "color",
      "default": "{color.semantic.surface}"
    }
  ],
  "examples": [
    {
      "label": "Retail EAN-13",
      "values": {
        "value": "4006381333931",
        "symbology": "auto",
        "color": "#1a1a2e",
        "background": "#faf7f2"
      }
    },
    {
      "label": "Compact EAN-8",
      "values": {
        "value": "96385074",
        "symbology": "ean8",
        "moduleWidth": 4,
        "barHeight": 120,
        "color": "#14324a",
        "background": "#f2f6f8"
      }
    },
    {
      "label": "Asset tag, Code 128",
      "values": {
        "value": "LOLLY-ASSET-00417",
        "symbology": "code128",
        "barHeight": 120,
        "color": "#1f2937",
        "background": "#f7f7f5"
      }
    },
    {
      "label": "UPC-A retail",
      "values": {
        "value": "036000291452",
        "symbology": "upca",
        "color": "#3f3f46",
        "background": "#fafaf9"
      }
    }
  ]
}
