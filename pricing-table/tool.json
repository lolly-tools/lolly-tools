{
  "id": "pricing-table",
  "name": "Pricing Table",
  "description": "Plans as columns, features as rows, ticks and crosses, and one plan picked out as the recommended one.",
  "a11yLabel": "Pricing table: {{default heading \"Pricing\"}}",
  "version": "1.0.0",
  "engineVersion": "^1.82.0",
  "status": "community",
  "category": "everyone",
  "tags": ["pricing", "comparison", "table", "features", "plans", "marketing"],
  "examples": [
    {
      "label": "SaaS three tiers",
      "values": {
        "heading": "Simple, transparent pricing",
        "subheading": "Every plan includes the whole toolkit. Pay for the seats and support you need.",
        "accent": "#2563eb",
        "background": "#f6f8fc",
        "color": "#16202b",
        "highlight": 2
      }
    },
    {
      "label": "Two-product comparison",
      "values": {
        "heading": "How we compare",
        "subheading": "The same job, side by side.",
        "cta": "Switch today",
        "highlight": 1,
        "highlightLabel": "Our pick",
        "accent": "#0d7a5f",
        "background": "#f5f7f4",
        "color": "#132019",
        "layout": "cards",
        "data": {
          "columns": ["Feature", "Lolly", "The usual tool"],
          "rows": [
            ["Price", "Free", "$18 / month"],
            ["Tagline", "Runs on your device", "Runs on their servers"],
            ["Works offline", "yes", "no"],
            ["Files stay on your machine", "yes", "no"],
            ["Brand tokens built in", "yes", "no"],
            ["Print-ready PDF", "yes", "yes"],
            ["Command line", "yes", "no"]
          ]
        }
      }
    },
    {
      "label": "Five-tier grid",
      "values": {
        "heading": "Pick your seat count",
        "subheading": "Volume pricing, billed yearly.",
        "layout": "grid",
        "highlight": 0,
        "cta": "",
        "accent": "#7c3aed",
        "background": "#faf9fd",
        "color": "#1c1730",
        "data": {
          "columns": ["Feature", "Solo", "Duo", "Squad", "Studio", "Agency"],
          "rows": [
            ["Price", "$0", "$12", "$40", "$120", "$400"],
            ["Tagline", "1 seat", "2 seats", "10 seats", "40 seats", "Unlimited"],
            ["Shared brand kit", "no", "yes", "yes", "yes", "yes"],
            ["Batch renders", "-", "100", "2,000", "20,000", "Unlimited"],
            ["Single sign-on", "no", "no", "no", "yes", "yes"],
            ["Support", "Community", "Email", "Email", "> Priority", "> Named contact"]
          ]
        }
      }
    },
    {
      "label": "Ink accent on warm paper",
      "values": {
        "heading": "Membership",
        "subheading": "One workshop a month, or all of them.",
        "cta": "Join",
        "highlight": 3,
        "highlightLabel": "Best value",
        "accent": "#1f2933",
        "background": "#f7f4ee",
        "color": "#1f2933",
        "data": {
          "columns": ["Feature", "Visitor", "Member", "Patron"],
          "rows": [
            ["Price", "$0", "$15 / month", "$40 / month"],
            ["Tagline", "Drop in", "Every month", "Everything, plus"],
            ["Workshop seats", "1 a year", "1 a month", "Unlimited"],
            ["Recordings", "no", "yes", "yes"],
            ["Studio access", "no", "no", "yes"],
            ["Guest pass", "no", "1 a year", "4 a year"]
          ]
        }
      }
    }
  ],
  "render": {
    "width": 1600,
    "height": 1000,
    "formats": ["png", "svg", "pdf", "csv", "json"],
    "actions": ["copy", "download", "save"],
    "filenameFrom": ["heading"]
  },
  "inputs": [
    {
      "id": "data",
      "label": "Plans and features",
      "type": "table",
      "urlKey": "t",
      "help": "The first column holds feature names, every other column is a plan. The FIRST row is the price line for each plan. An optional SECOND row whose first cell reads Tagline or Subtitle gives each plan a one-line subtitle. Every row after that is a feature. In a cell: yes, y, true, check, tick or a check mark draws a tick; no, n, false, x, cross, - or a cross mark draws a cross; a leading >, <, ^ or v becomes an arrow; anything else prints as text. Paste a table straight from your spreadsheet to replace the whole grid.",
      "default": {
        "columns": ["Feature", "Starter", "Team", "Enterprise"],
        "rows": [
          ["Price", "$9 / month", "$29 / month", "Talk to us"],
          ["Tagline", "For solo work", "For growing teams", "For the whole org"],
          ["Projects", "3", "Unlimited", "Unlimited"],
          ["Team members", "1", "Up to 20", "Unlimited"],
          ["Shared brand kit", "no", "yes", "yes"],
          ["PDF and SVG export", "yes", "yes", "yes"],
          ["Single sign-on", "no", "no", "yes"],
          ["Support", "Community", "Email, next day", "> Named contact"]
        ]
      }
    },
    {
      "id": "heading",
      "label": "Heading",
      "type": "text",
      "default": "Simple, transparent pricing",
      "maxLength": 80
    },
    {
      "id": "subheading",
      "label": "Sub-heading",
      "type": "text",
      "default": "Every plan includes the whole toolkit. Pay for the seats and support you need.",
      "maxLength": 160
    },
    {
      "id": "cta",
      "label": "Button label",
      "type": "text",
      "default": "Get started",
      "maxLength": 40,
      "help": "Printed under every plan. Leave it empty to drop the button row."
    },
    {
      "id": "highlight",
      "label": "Featured plan",
      "type": "number",
      "display": "slider",
      "default": 2,
      "min": 0,
      "max": 8,
      "step": 1,
      "help": "Which plan column to pick out, counting from 1. Use 0 for no featured plan."
    },
    {
      "id": "highlightLabel",
      "label": "Featured label",
      "type": "text",
      "default": "Most popular",
      "maxLength": 32
    },
    {
      "id": "color",
      "label": "Text",
      "type": "color",
      "default": "{color.semantic.text}"
    },
    {
      "id": "background",
      "label": "Background",
      "type": "color",
      "default": "{color.semantic.surface}"
    },
    {
      "id": "accent",
      "label": "Accent",
      "type": "color",
      "default": "{color.semantic.primary}",
      "help": "Colours the ticks and the featured plan."
    },
    {
      "id": "layout",
      "label": "Layout",
      "type": "select",
      "default": "cards",
      "options": [
        { "value": "cards", "label": "Cards" },
        { "value": "grid", "label": "Comparison grid" }
      ],
      "help": "Cards gives each plan its own panel. Comparison grid is flat, with a hairline under every feature row."
    }
  ],
  "hooks": {
    "onInit": true,
    "onInput": true
  }
}
