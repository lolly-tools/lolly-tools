{
  "id": "battlecards",
  "name": "Battlecards",
  "description": "Turn any table into a deck of cards — one card per row, ready as a multi-page PDF. Paste straight from your spreadsheet, doc, or chat.",
  "a11yLabel": "Battlecards: {{default title \"Battlecards\"}} — one card per table row",
  "version": "1.1.0",
  "engineVersion": "^1.80.0",
  "status": "community",
  "category": "everyone",
  "tags": ["battlecard", "sales", "competitive", "table", "cards", "pdf", "pages", "batch"],
  "render": {
    "width": 1200,
    "height": 900,
    "formats": ["pdf", "png", "webp", "jpeg"],
    "actions": ["copy", "download", "save"],
    "paged": true,
    "filmstrip": "bottom",
    "paginate": { "source": "data" }
  },
  "inputs": [
    {
      "id": "data",
      "label": "Table",
      "type": "table",
      "urlKey": "t",
      "help": "One card per row. The first column is each card's title; the other column headings become its field labels. Cells take markdown — **bold**, *italic*, # headings, - bullet and 1. numbered lists, [links](url) and ![images](url). Paste a table copied from a spreadsheet, Notion, Slack, or Markdown.",
      "default": {
        "columns": ["Pain", "Summary", "SolutionName", "CompetitorName", "Strategy"],
        "rows": [
          ["Assurance", "Is it **open**?", "Yes", "Yes", "Table stakes — compete with *why*"],
          ["Provenance", "Where's it made?", "Europe", "North America", "Local advantage, global-qualify"],
          ["Jurisdiction", "What laws impact it?", "Good laws", "Risky laws", "1. Readiness play\n2. Compliance framework"],
          ["Reversibility", "Easy to leave?", "By design", "Walled garden", "- Real choice means you can act\n- No exit fee, no rewrite"]
        ]
      }
    },
    {
      "id": "title",
      "label": "Deck title",
      "type": "text",
      "default": "Battlecards",
      "maxLength": 80
    },
    {
      "id": "orientation",
      "label": "Orientation",
      "type": "select",
      "default": "landscape",
      "options": [
        { "value": "landscape", "label": "Landscape", "width": 1200, "height": 900 },
        { "value": "portrait", "label": "Portrait", "width": 900, "height": 1200 }
      ],
      "help": "The card layout adapts: fields flow as a grid in landscape and stack in portrait."
    },
    {
      "id": "accent",
      "label": "Accent",
      "type": "color",
      "default": "{color.semantic.primary}"
    },
    {
      "id": "bg",
      "label": "Background",
      "type": "color",
      "default": "{color.semantic.surface}"
    },
    {
      "id": "ink",
      "label": "Text",
      "type": "color",
      "default": "{color.semantic.text}"
    },
    {
      "id": "footer",
      "label": "Footer note",
      "type": "text",
      "default": "",
      "placeholder": "Internal use only · Q3 2026",
      "maxLength": 120
    }
  ]
}
