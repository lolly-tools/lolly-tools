{
  "id": "screenshot-frame",
  "name": "Screenshot Frame",
  "description": "Drop in a screenshot and get it framed, padded and shadowed on a brand backdrop.",
  "a11yLabel": "Screenshot in a {{default frame \"browser\"}} frame on a {{default backdrop \"gradient\"}} backdrop",
  "version": "1.0.1",
  "engineVersion": "^1.0.0",
  "status": "community",
  "category": "everyone",
  "tags": ["screenshot", "frame", "mockup", "device", "browser", "social"],
  "examples": [
    {
      "label": "Browser, light chrome",
      "values": { "frame": "browser", "windowStyle": "nuremberg", "url": "https://lolly.tools/gallery", "title": "Gallery", "backdrop": "gradient", "background": "{color.semantic.primary}", "color2": "{color.semantic.secondary}", "dark": false }
    },
    {
      "label": "Phone on a warm gradient",
      "values": { "frame": "phone", "title": "Field notes", "backdrop": "gradient", "background": "#f6c99f", "color2": "#e8836b", "padding": 72, "scale": 90, "shadow": 65 }
    },
    {
      "label": "Laptop on a solid brand ground",
      "values": { "frame": "laptop", "backdrop": "solid", "background": "{color.semantic.primary}", "padding": 88, "scale": 78, "radius": 10 }
    },
    {
      "label": "Bare shot, no backdrop",
      "values": { "frame": "none", "backdrop": "transparent", "padding": 48, "scale": 88, "radius": 24, "shadow": 40 }
    }
  ],
  "render": {
    "width": 1600,
    "height": 1000,
    "formats": ["png", "jpg", "webp", "svg", "pdf"],
    "actions": ["copy", "download", "save"],
    "filenameFrom": ["title", "url"],
    "transparentBg": false
  },
  "hooks": {
    "onInit": true,
    "onInput": true,
    "beforeExport": true
  },
  "inputs": [
    {
      "id": "image",
      "label": "Screenshot",
      "type": "asset",
      "assetType": "image",
      "allowUpload": true,
      "help": "Drop in a screen grab. Without one the frame shows a plain placeholder screen."
    },
    {
      "id": "frame",
      "label": "Frame",
      "type": "select",
      "default": "browser",
      "options": [
        { "value": "browser", "label": "Browser window" },
        { "value": "phone", "label": "Phone" },
        { "value": "laptop", "label": "Laptop" },
        { "value": "none", "label": "No frame" }
      ]
    },
    {
      "id": "windowStyle",
      "label": "Window buttons",
      "type": "select",
      "default": "nuremberg",
      "showIf": { "frame": "browser" },
      "help": "Window chrome look. Nuremberg = GNOME Adwaita, Cupertino = macOS, Redmond = Windows.",
      "options": [
        { "value": "cupertino", "label": "Cupertino" },
        { "value": "redmond", "label": "Redmond" },
        { "value": "nuremberg", "label": "Nuremberg" }
      ]
    },
    {
      "id": "url",
      "label": "Address",
      "type": "url",
      "default": "https://lolly.tools",
      "showIf": { "frame": "browser" },
      "help": "Shown in the address bar. The protocol is dropped."
    },
    {
      "id": "title",
      "label": "Title",
      "type": "text",
      "default": "",
      "placeholder": "Tab or status title"
    },
    {
      "id": "backdrop",
      "label": "Backdrop",
      "type": "select",
      "default": "gradient",
      "options": [
        { "value": "gradient", "label": "Gradient" },
        { "value": "solid", "label": "Solid colour" },
        { "value": "transparent", "label": "Transparent" }
      ]
    },
    {
      "id": "background",
      "label": "Backdrop colour",
      "type": "color",
      "default": "{color.semantic.primary}"
    },
    {
      "id": "color2",
      "label": "Second colour",
      "type": "color",
      "default": "{color.semantic.secondary}",
      "showIf": { "backdrop": "gradient" }
    },
    {
      "id": "padding",
      "label": "Padding",
      "type": "number",
      "display": "slider",
      "default": 72,
      "min": 0,
      "max": 200,
      "step": 4
    },
    {
      "id": "scale",
      "label": "Frame size",
      "type": "number",
      "display": "slider",
      "default": 78,
      "min": 50,
      "max": 100,
      "step": 1,
      "help": "Frame width as a percentage of the canvas."
    },
    {
      "id": "radius",
      "label": "Corner radius",
      "type": "number",
      "display": "slider",
      "default": 16,
      "min": 0,
      "max": 48,
      "step": 1
    },
    {
      "id": "shadow",
      "label": "Shadow",
      "type": "number",
      "display": "slider",
      "default": 55,
      "min": 0,
      "max": 100,
      "step": 1
    },
    {
      "id": "dark",
      "label": "Dark frame",
      "type": "boolean",
      "default": false
    }
  ]
}
