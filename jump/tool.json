{
  "id": "jump",
  "name": "Jump Page",
  "description": "A one-link landing page: up to ten links with a heading and your colours, and the whole page lives inside the link you share.",
  "a11yLabel": "Jump page {{default heading \"Links\"}} holding {{default linkCount \"no\"}} links",
  "version": "1.1.0",
  "engineVersion": "^1.82.0",
  "status": "community",
  "category": "utility",
  "tags": ["links", "landing", "linktree", "bio", "jump", "marketing", "share"],
  "examples": [
    {
      "label": "Studio front door",
      "values": {
        "heading": "Northwind Studio",
        "subheading": "Everything we make, one link.",
        "style": "buttons",
        "accent": "#2563eb",
        "background": "#f6f8fc",
        "color": "#16202b",
        "links": [
          { "label": "Portfolio", "url": "https://example.com/work" },
          { "label": "Book a session", "url": "https://example.com/book" },
          { "label": "Newsletter", "url": "https://example.com/news" },
          { "label": "Contact", "url": "https://example.com/hello" }
        ]
      }
    },
    {
      "label": "Conference talk",
      "values": {
        "heading": "Thanks for listening",
        "subheading": "The slides, the paper and the demo from today's talk.",
        "style": "cards",
        "accent": "#0d7a5f",
        "background": "#f5f7f4",
        "color": "#132019",
        "links": [
          { "label": "Slides (PDF)", "url": "https://example.com/talk/slides" },
          { "label": "The paper", "url": "https://example.com/talk/paper" },
          { "label": "Live demo", "url": "https://example.com/talk/demo" }
        ]
      }
    },
    {
      "label": "Quiet list",
      "values": {
        "heading": "Ana Kovac",
        "subheading": "",
        "style": "minimal",
        "accent": "#7c3aed",
        "background": "#faf9fd",
        "color": "#1c1730",
        "links": [
          { "label": "Writing", "url": "https://example.com/essays" },
          { "label": "Photography", "url": "https://example.com/photos" },
          { "label": "Now", "url": "https://example.com/now" }
        ]
      }
    },
    {
      "label": "Forwarder",
      "values": {
        "heading": "Redirecting",
        "subheading": "One link that forwards you on.",
        "onVisit": "gate",
        "accent": "#2563eb",
        "background": "#f6f8fc",
        "color": "#16202b",
        "links": [
          { "label": "Destination", "url": "https://example.com/live" }
        ]
      }
    }
  ],
  "render": {
    "width": 900,
    "height": 1400,
    "formats": ["html"],
    "export": false
  },
  "inputs": [
    {
      "id": "heading",
      "label": "Heading",
      "type": "text",
      "default": "Find us everywhere",
      "maxLength": 60
    },
    {
      "id": "subheading",
      "label": "Sub-heading",
      "type": "text",
      "default": "One link for all of it.",
      "maxLength": 120
    },
    {
      "id": "links",
      "label": "Links",
      "type": "blocks",
      "urlKey": "l",
      "help": "Up to ten. A label is optional - an empty one shows the site's own name. Share the page with the Share button: the whole page travels inside the link, so it works on any Lolly, offline, with nothing stored on a server. Add a password in the Share dialog and the page only opens for someone who knows it.",
      "fields": [
        { "id": "label", "label": "Label", "type": "text", "default": "" },
        { "id": "url", "label": "Address", "type": "text", "default": "" },
        { "id": "icon", "label": "Glyph", "type": "text", "default": "", "placeholder": "★" }
      ],
      "default": [
        { "label": "Website", "url": "https://example.com" },
        { "label": "Newsletter", "url": "https://example.com/news" },
        { "label": "Say hello", "url": "https://example.com/contact" }
      ]
    },
    {
      "id": "onVisit",
      "label": "On visit",
      "type": "select",
      "urlKey": "go",
      "default": "page",
      "help": "\"Forward\" turns the page into a redirect to the first link - a URL forwarder. Add a password in the Share dialog for a password-gated forwarder. \"Forward after a human check\" adds a press-and-hold step first, so a casual bot following the link does not sail straight through. The check is a speed bump, not proof: whoever holds a link without a password can still read where it points.",
      "options": [
        { "value": "page", "label": "Show the links page" },
        { "value": "forward", "label": "Forward to the first link" },
        { "value": "gate", "label": "Forward after a human check" }
      ]
    },
    {
      "id": "style",
      "label": "Style",
      "type": "select",
      "default": "cinema",
      "help": "\"Scroll cinema\" gives the shared page a full-height opening and one scene per link, animated as you scroll. The other three are a plain list.",
      "options": [
        { "value": "cinema", "label": "Scroll cinema" },
        { "value": "buttons", "label": "Buttons" },
        { "value": "cards", "label": "Cards" },
        { "value": "minimal", "label": "Minimal" }
      ]
    },
    {
      "id": "mood",
      "label": "Mood",
      "type": "select",
      "default": "calm",
      "help": "How far the scroll cinema moves. One dial over every animation - it changes nothing for the other styles, and nothing for a visitor who asks for reduced motion.",
      "options": [
        { "value": "calm", "label": "Calm" },
        { "value": "bold", "label": "Bold" },
        { "value": "electric", "label": "Electric" }
      ]
    },
    {
      "id": "color",
      "label": "Text",
      "type": "color",
      "default": "{color.semantic.text}"
    },
    {
      "id": "background",
      "label": "Background",
      "type": "color",
      "default": "{color.semantic.surface}"
    },
    {
      "id": "accent",
      "label": "Accent",
      "type": "color",
      "default": "{color.semantic.primary}",
      "help": "Colours the buttons and the link marks."
    },
    {
      "id": "footer",
      "label": "Show the Lolly line",
      "type": "boolean",
      "default": true,
      "help": "A visible \"Made with Lolly\" line closing the scroll cinema. Nothing is embedded in the link either way - turning it off simply removes the line."
    }
  ],
  "hooks": {
    "onInit": true,
    "onInput": true
  }
}
