{
  "id": "growth",
  "name": "Growth",
  "description": "Differential growth: a line that repels itself until it folds into coral. Seed it from a ring, a burst, your headline's letterforms or your logo, and export the result as real, plotter-ready SVG paths.",
  "a11yLabel": "Differential growth pattern grown from a {{seedShape}} seed",
  "version": "1.0.0",
  "engineVersion": "^1.152.0",
  "status": "community",
  "category": "designer",
  "tags": ["generative", "art", "plotter", "vector", "svg", "organic", "pattern"],
  "examples": [
    { "label": "Coral bloom", "values": { "seedShape": "burst", "density": 58, "steps": 300, "weight": 2, "seed": 7 } },
    { "label": "Rosette", "values": { "seedShape": "ring", "symmetry": "radial-6", "density": 52, "steps": 155, "weight": 1.5, "seed": 12 } },
    { "label": "Ribbon", "values": { "seedShape": "line", "symmetry": "mirror", "density": 45, "steps": 280, "weight": 3, "seed": 3 } },
    { "label": "Grown wordmark", "values": { "seedShape": "text", "text": "GROW", "density": 74, "steps": 200, "weight": 1.5, "seed": 21 } }
  ],
  "render": {
    "width": 1200,
    "height": 1200,
    "formats": ["svg", "pdf", "png", "jpg", "webp", "gif", "webm", "mp4"],
    "actions": ["copy", "download", "save"],
    "convertPaths": false,
    "video": { "wait": 0, "duration": 6 }
  },
  "inputs": [
    {
      "id": "seedShape",
      "label": "Seed",
      "type": "select",
      "default": "burst",
      "help": "What the growth starts from. Text and Logo trace your own outlines, so every counter and hole grows into its own organism.",
      "options": [
        { "value": "burst", "label": "Burst (several rings)" },
        { "value": "ring", "label": "Ring" },
        { "value": "line", "label": "Line" },
        { "value": "text", "label": "Text" },
        { "value": "logo", "label": "Logo" }
      ]
    },
    {
      "id": "text",
      "label": "Headline",
      "type": "text",
      "default": "GROW",
      "maxLength": 60,
      "showIf": { "seedShape": ["text"] },
      "help": "Outlined in your brand font, then grown."
    },
    {
      "id": "logo",
      "label": "Logo",
      "type": "asset",
      "showIf": { "seedShape": ["logo"] },
      "help": "Traced as a silhouette at a fixed sampling size, so the same logo always seeds the same shape."
    },
    { "id": "color1", "label": "Colour 1", "type": "color", "default": "{color.semantic.primary}" },
    { "id": "color2", "label": "Colour 2", "type": "color", "default": "{color.semantic.secondary}", "showIf": { "seedShape": ["burst", "text", "logo"] }, "help": "Colours cycle by loop, so a single-loop seed (Ring, Line) only ever uses Colour 1." },
    { "id": "color3", "label": "Colour 3", "type": "color", "default": "{color.spectrum.teal}", "showIf": { "seedShape": ["burst", "text", "logo"] } },
    { "id": "background", "label": "Background", "type": "color", "default": "{color.semantic.surface}" },
    {
      "id": "density",
      "label": "Density",
      "section": "Growth",
      "type": "number",
      "display": "slider",
      "default": 58,
      "min": 20,
      "max": 100,
      "step": 1,
      "help": "How tightly the line packs against itself. Higher is finer and slower."
    },
    {
      "id": "steps",
      "label": "Steps",
      "section": "Growth",
      "type": "number",
      "display": "slider",
      "default": 300,
      "min": 20,
      "max": 2400,
      "step": 10,
      "help": "How long it grows for. The pattern stops filling once it runs out of nodes, so very high values mostly just take longer."
    },
    {
      "id": "symmetry",
      "label": "Symmetry",
      "section": "Growth",
      "type": "select",
      "default": "none",
      "help": "Grows one organism and stamps it around the centre.",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "mirror", "label": "Mirror" },
        { "value": "radial-3", "label": "Radial x3" },
        { "value": "radial-6", "label": "Radial x6" }
      ]
    },
    {
      "id": "weight",
      "label": "Line weight",
      "section": "Line",
      "type": "number",
      "display": "slider",
      "default": 2,
      "min": 0.5,
      "max": 8,
      "step": 0.5
    },
    {
      "id": "taper",
      "label": "Taper",
      "section": "Line",
      "type": "boolean",
      "default": false,
      "showIf": { "seedShape": ["burst", "text", "logo"] },
      "help": "Thins each successive loop, so older growth reads heavier."
    },
    {
      "id": "seed",
      "label": "Seed",
      "section": "Line",
      "type": "number",
      "default": 7,
      "min": 0,
      "max": 9999,
      "step": 1,
      "help": "Same seed and settings always grow the same pattern."
    },
    {
      "id": "grown",
      "label": "Show it grown",
      "section": "Line",
      "type": "boolean",
      "default": true,
      "help": "Off plays the growth from the seed instead of landing on the finished piece, and is what an animated export records."
    }
  ],
  "hooks": {
    "onInit": true,
    "onInput": true
  }
}
